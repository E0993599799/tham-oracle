#!/usr/bin/env bash
# Oracle Toolkit — CLI wrapper for Omega/Forge orchestration
# Usage: oracle <command> [args]
# Version: 1.0.0

set -euo pipefail

ORACLE_ROOT="/root/ghq/github.com/E0993599799/tham-oracle"
SCRIPT_DIR="$ORACLE_ROOT/scripts"
CONFIGS_DIR="$ORACLE_ROOT/configs"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ============================================================================
# TMUX SESSION COMMANDS
# ============================================================================

tmux_start() {
  echo -e "${BLUE}▶ Starting oracle-session (4-window)...${NC}"
  bash "$SCRIPT_DIR/oracle-session.sh"
}

tmux_fleet() {
  echo -e "${BLUE}▶ Starting oracle-fleet (3×2 panes)...${NC}"
  bash "$SCRIPT_DIR/oracle-fleet.sh" || true
  if tmux has-session -t "oracle-fleet" 2>/dev/null; then
    tmux attach-session -t "oracle-fleet"
  fi
}

tmux_lanes() {
  echo -e "${BLUE}▶ Starting 5-lane orchestration...${NC}"
  bash "$SCRIPT_DIR/launch-lanes.sh"
}

tmux_attach() {
  # Try attach to oracle session first, then oracle-fleet, then lanes
  for session in oracle oracle-fleet lanes; do
    if tmux has-session -t "$session" 2>/dev/null; then
      echo -e "${BLUE}▶ Attaching to '$session'...${NC}"
      exec tmux attach-session -t "$session"
    fi
  done
  echo -e "${RED}✗ No active tmux session found (oracle, oracle-fleet, or lanes)${NC}"
  echo "  Start one: oracle tmux:start"
  exit 1
}

# ============================================================================
# LANE DISPATCH COMMANDS (tmux send-keys)
# ============================================================================

lane_dispatch() {
  local lane="$1"
  shift
  local task="$@"

  # Check if lanes session is running
  if ! tmux has-session -t "lanes" 2>/dev/null; then
    echo -e "${RED}✗ lanes session not running${NC}"
    echo "  Start it: oracle tmux:lanes"
    exit 1
  fi

  case "$lane" in
    codex)
      echo -e "${BLUE}▶ Sending task to CODEX-A: ${YELLOW}$task${NC}"
      tmux send-keys -t "lanes:codex-a" "$task" Enter
      tmux select-window -t "lanes:codex-a"
      echo -e "${GREEN}✓ Task dispatched (in codex-a pane)${NC}"
      ;;
    research|gemini)
      echo -e "${BLUE}▶ Sending task to GEMINI: ${YELLOW}$task${NC}"
      tmux send-keys -t "lanes:gemini" "$task" Enter
      tmux select-window -t "lanes:gemini"
      echo -e "${GREEN}✓ Task dispatched (in gemini pane)${NC}"
      ;;
    core)
      echo -e "${BLUE}▶ Sending task to CORE: ${YELLOW}$task${NC}"
      tmux send-keys -t "lanes:tham" "$task" Enter
      tmux select-window -t "lanes:tham"
      echo -e "${GREEN}✓ Task dispatched (in tham pane)${NC}"
      ;;
    *)
      echo -e "${RED}✗ Unknown lane: $lane${NC}"
      echo "  Available lanes: codex, research, core"
      exit 1
      ;;
  esac
}

# ============================================================================
# QUEUE & INBOX COMMANDS
# ============================================================================

queue_check() {
  echo -e "${BLUE}▶ Checking inbox status...${NC}"
  local inbox_dir="$ORACLE_ROOT/ψ/inbox"

  if [ ! -d "$inbox_dir" ]; then
    echo -e "${YELLOW}! ψ/inbox/ not found${NC}"
    return 1
  fi

  local total=0
  for agent_dir in "$inbox_dir"/*; do
    if [ -d "$agent_dir" ]; then
      local agent=$(basename "$agent_dir")
      local count=$(ls -1 "$agent_dir" 2>/dev/null | wc -l)
      total=$((total + count))

      if [ "$count" -gt 0 ]; then
        echo -e "  ${YELLOW}$agent${NC}: $count files"
      else
        echo -e "  ${GREEN}$agent${NC}: empty"
      fi
    fi
  done

  echo -e "${BLUE}────────────────${NC}"
  echo -e "  Total: ${YELLOW}$total${NC} files"
}

# ============================================================================
# PROOF COMMANDS
# ============================================================================

proof_last() {
  echo -e "${BLUE}▶ Last proof summary...${NC}"
  local proof_summary="$ORACLE_ROOT/ψ/memory/resonance/router-proof-summary.md"

  if [ ! -f "$proof_summary" ]; then
    echo -e "${YELLOW}! No proof summary found${NC}"
    return 1
  fi

  # Show last 20 lines
  echo ""
  tail -n 20 "$proof_summary"
}

# ============================================================================
# STATUS & HEALTH COMMANDS
# ============================================================================

status() {
  echo -e "${BLUE}🧠 Oracle Toolkit Status${NC}"
  echo ""

  # Check 9router
  echo -n "  9router (port 20128):     "
  if timeout 1 curl -s http://127.0.0.1:20128/v1/models >/dev/null 2>&1; then
    echo -e "${GREEN}✓ UP${NC}"
  else
    echo -e "${RED}✗ DOWN${NC}"
  fi

  # Check oracle-v2
  echo -n "  oracle-v2 (port 47778):   "
  if timeout 1 curl -s http://127.0.0.1:47778/health >/dev/null 2>&1; then
    echo -e "${GREEN}✓ UP${NC}"
  else
    echo -e "${YELLOW}? UNKNOWN${NC}"
  fi

  # Check tmux sessions
  echo -n "  tmux sessions:            "
  local sessions=$(tmux list-sessions 2>/dev/null | wc -l)
  if [ "$sessions" -gt 0 ]; then
    echo -e "${GREEN}✓ $sessions running${NC}"
    tmux list-sessions 2>/dev/null | sed 's/^/    /'
  else
    echo -e "${YELLOW}○ none${NC}"
  fi

  # Git status (current branch, dirty)
  echo -n "  Git branch:               "
  if [ -d "$ORACLE_ROOT/.git" ]; then
    local branch=$(cd "$ORACLE_ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    local dirty=$(cd "$ORACLE_ROOT" && git status --porcelain 2>/dev/null | wc -l)
    if [ "$dirty" -gt 0 ]; then
      echo -e "${YELLOW}$branch (dirty: $dirty files)${NC}"
    else
      echo -e "${GREEN}$branch (clean)${NC}"
    fi
  else
    echo -e "${RED}✗ Not a git repo${NC}"
  fi

  echo ""
}

# ============================================================================
# RTK PRECONTEXT COMMAND
# ============================================================================

rtk_precontext() {
  echo -e "${BLUE}▶ RTK Precontext Block${NC}"
  echo ""

  local branch=$(cd "$ORACLE_ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
  local last_commit=$(cd "$ORACLE_ROOT" && git log -1 --oneline 2>/dev/null || echo "?")
  local git_status=$(cd "$ORACLE_ROOT" && git status --porcelain 2>/dev/null | wc -l)

  cat << EOF
# RTK Runtime Toolkit Context

export ORACLE_ROOT="$ORACLE_ROOT"
export GIT_BRANCH="$branch"
export GIT_STATUS="$git_status files changed"
export LAST_COMMIT="$last_commit"

# Services
export PORT_9ROUTER=20128
export PORT_ORACLE_V2=47778
export PORT_STUDIO=3000

# Ready to execute
echo "✓ RTK initialized: branch=$branch, status=$git_status files"
EOF
  echo ""
}

# ============================================================================
# GIT/PR COMMANDS
# ============================================================================

pr_create() {
  local branch="${1:-}"

  if [ -z "$branch" ]; then
    # Get current branch
    branch=$(cd "$ORACLE_ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
      echo -e "${RED}✗ Not on a branch. Specify branch name: oracle pr-create <branch>${NC}"
      exit 1
    fi
  fi

  echo -e "${BLUE}▶ Creating PR for branch: ${YELLOW}$branch${NC}"

  # Pre-checks
  cd "$ORACLE_ROOT"

  local dirty=$(git status --porcelain 2>/dev/null | wc -l)
  if [ "$dirty" -gt 0 ]; then
    echo -e "${RED}✗ Working tree dirty. Commit changes first.${NC}"
    exit 1
  fi

  local commits=$(git log origin/main..$branch 2>/dev/null | grep -c "^commit" || true)
  if [ "$commits" -eq 0 ]; then
    echo -e "${RED}✗ No commits to push. Did you commit?${NC}"
    exit 1
  fi

  # Push first
  echo "  Pushing $commits commit(s)..."
  git push -u origin "$branch" 2>/dev/null || true

  # Create PR using gh CLI
  echo "  Creating PR..."
  if command -v gh &> /dev/null; then
    gh pr create --head "$branch" --fill 2>/dev/null && \
      echo -e "${GREEN}✓ PR created${NC}" || \
      echo -e "${YELLOW}! PR creation had issues (may already exist)${NC}"
  else
    echo -e "${RED}✗ gh CLI not found. Install with: brew install gh${NC}"
    exit 1
  fi
}

# ============================================================================
# HELP
# ============================================================================

show_help() {
  cat << 'EOF'
Oracle Toolkit v1.0.0 — Omega/Forge Orchestration CLI

USAGE
  oracle <command> [args]

TMUX SESSION COMMANDS
  tmux:start              Start oracle-session (4-window)
  tmux:fleet              Start oracle-fleet (3×2 panes)
  tmux:lanes              Start 5-lane multi-agent session
  tmux:attach             Attach to running session (oracle, oracle-fleet, or lanes)

LANE DISPATCH (requires "lanes" session running)
  lane:codex "task"       Send task to CODEX-A window
  lane:research "query"   Send query to GEMINI window
  lane:core "task"        Send task to CORE/THAM window

QUEUE & INBOX
  queue:check             List ψ/inbox/ folders and file counts
  proof:last              Show last proof summary

STATUS & HEALTH
  status                  Quick health check (9router, oracle-v2, tmux, git)
  rtk                     Print RTK precontext block (for shell scripts)

GIT & PR WORKFLOW
  pr-create [branch]      Safe: check dirty, push, create PR via gh CLI

OTHER
  help                    Show this help message
  version                 Show version

EXAMPLES
  oracle tmux:start                  # Open main session
  oracle tmux:lanes                  # Open 5-lane orchestration
  oracle status                      # Check all services
  oracle lane:codex "implement X"    # Send task to codex worker
  oracle queue:check                 # Check inbox
  oracle rtk                         # Get precontext block

ALIASES
  After running 'bash scripts/setup-oracle-aliases.sh':

  oracle, cc, ccd, gs, gl, gd, tm, lanes, fleet, inbox, proof

DOCUMENTATION
  See docs/oracle-toolkit.md for detailed reference

EOF
}

# ============================================================================
# MAIN DISPATCHER
# ============================================================================

main() {
  local cmd="${1:-help}"

  case "$cmd" in
    # Tmux
    tmux:start)        tmux_start ;;
    tmux:fleet)        tmux_fleet ;;
    tmux:lanes)        tmux_lanes ;;
    tmux:attach)       tmux_attach ;;

    # Lane dispatch
    lane:codex)        lane_dispatch "codex" "${@:2}" ;;
    lane:research)     lane_dispatch "research" "${@:2}" ;;
    lane:gemini)       lane_dispatch "research" "${@:2}" ;;
    lane:core)         lane_dispatch "core" "${@:2}" ;;

    # Queue
    queue:check)       queue_check ;;
    inbox)             queue_check ;;

    # Proof
    proof:last)        proof_last ;;
    proof)             proof_last ;;

    # Status
    status)            status ;;
    rtk)               rtk_precontext ;;

    # Git/PR
    pr-create)         pr_create "${2:-}" ;;

    # Help
    help)              show_help ;;
    version)           echo "Oracle Toolkit v1.0.0" ;;
    -h|--help)         show_help ;;
    -v|--version)      echo "Oracle Toolkit v1.0.0" ;;

    *)
      echo -e "${RED}✗ Unknown command: $cmd${NC}"
      echo "Run 'oracle help' for usage"
      exit 1
      ;;
  esac
}

main "$@"
