  "oracle": {
    "tham": { "port": 47778, "status": "active" },
    "dev":  { "port": 47779, "status": "template/inactive" },
    "qa":   { "port": 47780, "status": "template/inactive" }
  },

  "studio": {
    "port": 3000,
    "api_target": "http://localhost:47778"
  },

  "persistence": {
    "preferred": "supabase",
    "fallback": "sqlite-local",
    "note": "Do NOT default to better-sqlite3/native sqlite for runtime persistence"
  },

  "flow": {
    "steps": [
      "natural-language-input",
      "intent-decode",
      "memory-gate",
      "risk-gate",
      "contract",
      "executor-lane-router",
      "execution",
      "proof-reader",
      "dashboard-update",
      "writeback"
    ],
    "writebacks": ["obsidian", "notion", "github"]
  },

  "rules": {
    "no_force_push": true,
    "no_secrets_in_commits": true,
    "hermes_not_default": true,
    "no_cmd_popup": true,
    "proof_before_ok": true,
    "powershell_first_windows": true,
    "wsl_linux_only_when_required": true
  },

  "providers": {
    "9router": {
      "base_url": "http://172.21.112.1:20128/v1",
      "api_key_env": "OPENCLAW_API_KEY",
      "status": "active",
      "port": 20128,
      "models": {
        "codex": "cx/gpt-5.5",
        "gemini": "gemini/gemini-2.5-flash"
      },
      "available": [
        "cx/gpt-5.5",
        "gemini/gemini-2.5-flash"
      ]
    },
    "hermes": {
      "provider": "gemini",
      "base_url": "http://172.21.112.1:20128/v1",
      "model": "gemini/gemini-2.5-flash",
      "api_key_env": "OPENCLAW_API_KEY",
      "status": "active",
      "verified": "2026-05-19",
