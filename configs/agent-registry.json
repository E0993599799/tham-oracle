      "runtime": "claude-code (via 9router)",
      "lane_card": "configs/lane-cards/mind-planner.json",
      "merged_from": ["bob", "hermes"],
      "tmux_target": "tham-oracle-stack:fleet-ops.2",
      "status": "active",
      "memory_access": "read-only",
      "capabilities": [
        "task-decomposition", "agent-assignment", "ops-coordination",
        "multi-step-planning", "legacy-integration", "migration-planning",
        "compatibility-analysis", "risk-assessment",
        "queue-management", "inter-oracle-relay"
