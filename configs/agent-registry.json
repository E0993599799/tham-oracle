{
  "_comment": "Tham Oracle fleet registry v3.0 — consolidated 4-agent fleet (tham + forge + mind + eye). Old 8-agent registry archived in configs/lane-cards/archive/.",
  "_version": "3.0",
  "_updated": "2026-05-27",
  "_changelog": "v3.0: Consolidated 8 agents → 4 (forge=codex+core+housekeeper+powershell, mind=bob+hermes, eye=gemini+watchdog). Fleet window: tham-oracle-stack:fleet-ops",

  "fleet": {
    "agent_count": 4,
    "provider_count": 3,
    "internal_engines": ["RTK Context Engine"],
    "layout": {
      "session": "tham-oracle-stack",
      "window": "fleet-ops",
      "panes": {
        "0": "tham (upper-left — Governor)",
        "1": "forge (lower-left — Builder)",
        "2": "mind (right-top — Planner)",
        "3": "eye (right-mid — Inspector)",
        "4": "reserve (right-bot — overflow / ad-hoc)"
      }
    }
  },

  "providers": [
    {
      "id": "Native Claude",
      "use_for": "Tham Oracle governance, memory, reasoning, instruction hierarchy, final synthesis",
      "note": "tham-oracle project uses native Claude API (env: .env.tham reverts ANTHROPIC_API_BASE_URL)"
    },
    {
      "id": "Codex (via 9router)",
      "primary_model": "nvidia/minimaxai/minimax-m2.7",
      "backup_model": "openrouter/qwen/qwen3-coder:free",
      "base_url": "http://172.21.112.1:20128/v1",
      "use_for": "code execution, implementation, planning, coordination, maintenance, Windows automation"
    },
    {
      "id": "Gemini (via 9router)",
      "primary_model": "gemini/gemini-3.1-pro-preview",
      "fallback_model": "gemini/gemini-3-flash-preview",
      "base_url": "http://172.21.112.1:20128/v1",
      "use_for": "large-context review, research, health monitoring, anomaly detection, second-pass validation"
    }
  ],

  "agents": [
    {
      "id": "tham",
      "display_name": "ธาม",
      "role": "Observer / Governor / Memory Owner",
      "soul": "ธาม — CTO/Mission Control. ไม่ execute เอง แต่ govern, delegate, และ verify proof ทุกครั้ง",
      "provider": "Native Claude",
      "runtime": "claude-code",
      "lane_card": "configs/lane-cards/tham-orchestrator.json",
      "tmux_target": "tham-oracle-stack:fleet-ops.0",
      "status": "active",
      "memory_access": "full owner (ψ vault, brain/, oracle-v2 DB)",
      "capabilities": ["govern", "route", "verify-proof", "memory-write", "human-interface", "final-synthesis"],
      "routing": "receives all intent from พี่เอก, delegates to forge/mind/eye"
    },
    {
      "id": "forge",
      "display_name": "FORGE",
      "role": "Builder / Runner / Maintenance",
      "soul": "Forges code into existence. Builds, fixes, maintains, automates. Windows to Linux.",
