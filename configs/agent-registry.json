      "runtime": "gemini-cli (via 9router)",
      "lane_card": "configs/lane-cards/eye-inspector.json",
      "merged_from": ["gemini", "watchdog"],
      "tmux_target": "tham-oracle-stack:fleet-ops.3",
      "status": "active",
      "memory_access": "read-only",
      "capabilities": [
        "code-review", "large-context-inspection", "research-synthesis",
        "fact-verification", "pattern-recognition", "second-pass-reasoning",
        "health-monitoring", "anomaly-detection", "security-scanning",
        "multimodal-analysis"
