      "runtime": "claude-code (via 9router)",
      "lane_card": "configs/lane-cards/forge-builder.json",
      "merged_from": ["codex", "core", "housekeeper", "powershell-sfsr"],
      "tmux_target": "tham-oracle-stack:fleet-ops.1",
      "status": "active",
      "memory_access": "read-only (ψ vault, CLAUDE.md)",
      "capabilities": [
        "write-code", "fix-bug", "refactor", "code-review", "security-audit",
        "cleanup", "file-organization", "dependency-hygiene",
        "powershell-automation", "wsl-linux-setup",
        "git-safe-workflow", "github-cli-workflow", "shell-execution"
      ],
      "output_contract": ["RESULT", "PROOF", "RISKS", "MEMORY_DELTA"]
    },
    {
      "id": "mind",
      "display_name": "MIND",
      "role": "Planner / Coordinator / Legacy Integrator",
      "soul": "Plans the path through chaos. Breaks problems, coordinates agents, bridges old to new.",
