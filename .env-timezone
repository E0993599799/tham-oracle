# Timezone Configuration — GMT+7 (Bangkok)
# Source this file in all scripts to ensure consistent timestamps

export TZ='Asia/Bangkok'
export LANG='th_TH.UTF-8'

# Function to get current timestamp in required format
timestamp_gmt7() {
    date '+%d_%b_%y:%H:%M:%S'
}

# Function to format agent message with timestamp
agent_message() {
    local agent_name=$1
    local message=$2
    echo "🔷 $agent_name $(timestamp_gmt7) — $message"
}
