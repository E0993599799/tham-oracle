{
  "name": "omega-os-mobile",
  "version": "0.1.0",
  "description": "Omega OS Mobile Dashboard — iOS and Android",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "expo start --web",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build:ios": "cd ios && xcodebuild -workspace OmegaOS.xcworkspace -scheme OmegaOS -configuration Release -derivedDataPath build",
    "build:android": "cd android && ./gradlew assembleRelease",
    "bundle": "node ./scripts/bundle.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-gesture-handler": "^2.14.0",
    "@react-native-firebase/app": "^18.3.0",
    "@react-native-firebase/messaging": "^18.3.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-chart-kit": "^6.12.0",
    "axios": "^1.6.0",
    "ws": "^8.14.0",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
